# StudyNest environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# --- Database (Postgres on Supabase) ---
# Use the connection string from Supabase: Project Settings -> Database -> Connection string
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/studynest

# --- LLM provider ---
# Which provider to use: gemini | groq
LLM_PROVIDER=gemini

# Google Gemini (primary)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Per-user rate limit on LLM-backed features (calls / minute)
LLM_PER_USER_RATE_LIMIT=10

# --- Auth ---
# Sign-in attempts per minute per IP
SIGNIN_RATE_LIMIT=5

# --- Content sync ---
# Set to true to re-sync content/ files into the DB on every app startup.
# Production typically syncs only on deploy; keep false in long-running processes.
CONTENT_SYNC_ON_STARTUP=true

# --- Initial admin account ---
# Seeded on first app startup if no user with INITIAL_ADMIN_HANDLE exists.
# After the admin has signed in once, these are never read again — change them
# via the account page (/auth/change-password), not by editing this file.
INITIAL_ADMIN_HANDLE=T-Level Tutor
INITIAL_ADMIN_PASSWORD=Best!Tutor@2026

# --- Auto-create tables ---
# In development, create missing tables on startup. In production, leave this
# false and rely on `alembic upgrade head` to manage schema.
AUTO_CREATE_TABLES=true
